# Supabase — copiar a .env.local (nunca commitear el archivo real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para Edge Functions / scripts server-side. JAMAS exponer al cliente
# ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Clave simétrica para cifrado AES-256 de campos sensibles (pgcrypto).
# Generar con: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Google OAuth (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Rate limiting (Upstash Redis — plan gratuito)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IA — Fase futura
ANTHROPIC_API_KEY=
