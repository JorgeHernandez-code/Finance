# Supabase — copiar a .env.local (nunca commitear el archivo real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para Edge Functions / scripts server-side. JAMAS exponer al cliente
# ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Reservada para cifrado a nivel de columna (pgcrypto) — diseñada pero aún
# no usada por ningún caso de uso (ver docs/02-BASE-DE-DATOS.md §5).
# Generar con: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Google OAuth: no es una env var de esta app — se configura como proveedor
# directamente en el dashboard de Supabase (Authentication > Providers).

# Rate limiting (Upstash Redis — plan gratuito). Si se dejan vacías, cae
# automáticamente a un limitador en memoria (no distribuido).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IA — Fase futura
ANTHROPIC_API_KEY=
